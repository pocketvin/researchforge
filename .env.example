# Copy to .env for local development. Never commit .env.
# V2 supports OpenAI, Qwen, or role-routed hybrid; provider secrets stay local.
RESEARCHFORGE_PROVIDER=openai
OPENAI_API_KEY=
# Set to 1 only after the previously exposed key has been revoked and replaced locally.
RESEARCHFORGE_ROTATED_KEY_CONFIRMED=0
RESEARCHFORGE_MODEL=gpt-5.6-luna
# Qwen Model Studio OpenAI-compatible endpoint. Use the endpoint that belongs to
# the same workspace/region as the key. V2 currently uses a vision-capable model
# so inspect_page_image remains a real capability.
RESEARCHFORGE_QWEN_API_KEY=
RESEARCHFORGE_QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RESEARCHFORGE_QWEN_MODEL=qwen-plus
RESEARCHFORGE_QWEN_REVIEW_MODEL=qwen-plus
RESEARCHFORGE_QWEN_FALLBACK_SYNTHESIS_MODEL=qwen3-max
RESEARCHFORGE_QWEN_VISION_MODEL=qwen3-vl-plus
# Hybrid routing: DeepSeek handles research, Reflection and Synthesis; Qwen handles
# semantic review plus research/synthesis fallbacks; Qwen3-VL handles page images.
# Kimi is optional standby metadata today and is not required for the active hybrid route.
RESEARCHFORGE_DEEPSEEK_API_KEY=
RESEARCHFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com
RESEARCHFORGE_DEEPSEEK_MODEL=deepseek-v4-flash
RESEARCHFORGE_KIMI_API_KEY=
RESEARCHFORGE_KIMI_BASE_URL=https://api.moonshot.cn/v1
RESEARCHFORGE_KIMI_MODEL=kimi-k3
RESEARCHFORGE_REASONING_EFFORT=medium
RESEARCHFORGE_REASONING_MODE=auto
RESEARCHFORGE_OPENAI_STORE=false
RESEARCHFORGE_BUDGET_USD=20.00
RESEARCHFORGE_V2_RUN_BUDGET_USD=0.35
RESEARCHFORGE_ARTIFACT_ROOT=./artifacts
# Enable interactive API docs only in a trusted local development environment.
RESEARCHFORGE_API_DOCS_ENABLED=false
# SEC asks automated clients to identify the application and a real contact email.
RESEARCHFORGE_SEC_USER_AGENT=ResearchForge/2.0 your-email@example.com
