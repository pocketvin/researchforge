# Copy to .env for local development. Never commit .env.
OPENAI_API_KEY=
# Set to 1 only after the previously exposed key has been revoked and replaced locally.
RESEARCHFORGE_ROTATED_KEY_CONFIRMED=0
RESEARCHFORGE_MODEL=gpt-5.6-luna
RESEARCHFORGE_REASONING_EFFORT=medium
RESEARCHFORGE_REASONING_MODE=auto
RESEARCHFORGE_OPENAI_STORE=false
RESEARCHFORGE_BUDGET_USD=20.00
RESEARCHFORGE_DATABASE_URL=postgresql+psycopg://researchforge:researchforge@localhost:5432/researchforge
RESEARCHFORGE_DATABASE_ENABLED=false
RESEARCHFORGE_ARTIFACT_ROOT=./artifacts
RESEARCHFORGE_DATA_NAMESPACE=product
# Optional explicit package root. Product mode never falls back to data/fixtures.
RESEARCHFORGE_DATA_ROOT=./data/product/packages
# SEC asks automated clients to identify the application and a real contact email.
RESEARCHFORGE_SEC_USER_AGENT=ResearchForge/1.7.3 your-email@example.com
