{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.7/research-result.schema.json",
  "title": "ResearchForge V1.7 General Research Result",
  "description": "Question-aware, evidence-first single-company research result over official filing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "run_id",
    "task_type",
    "research_question",
    "companies",
    "requested_periods",
    "research_time",
    "evidence_cutoff",
    "status",
    "research_intent",
    "research_plan",
    "executive_summary",
    "financial_snapshot_fact_ids",
    "mandatory_checks",
    "claims",
    "risk_claim_ids",
    "monitoring_items",
    "source_document_ids",
    "limitations",
    "skill_version",
    "skill_hash",
    "formula_version",
    "generated_at",
    "analysis_sections",
    "overall_judgment",
    "suggested_follow_ups",
    "evidence_coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.7.0"
    },
    "result_id": {
      "$ref": "../v1.4/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "../v1.4/common.schema.json#/$defs/identifier"
    },
    "task_type": {
      "type": "string",
      "const": "company_research"
    },
    "research_question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "../v1.4/common.schema.json#/$defs/company"
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "requested_periods": {
      "type": "array",
      "items": {
        "$ref": "../v1.4/common.schema.json#/$defs/reportingPeriod"
      },
      "minItems": 1,
      "maxItems": 12
    },
    "research_time": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "research_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "description",
          "status"
        ],
        "properties": {
          "step_id": {
            "$ref": "../v1.4/common.schema.json#/$defs/identifier"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "skipped",
              "blocked"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      },
      "minItems": 1,
      "maxItems": 30
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "financial_snapshot_fact_ids": {
      "type": "array",
      "items": {
        "$ref": "../v1.4/common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "mandatory_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_code",
          "status",
          "fact_ids",
          "evidence_ids",
          "finding"
        ],
        "properties": {
          "check_code": {
            "type": "string",
            "enum": [
              "revenue_trend",
              "profit_trend",
              "gross_margin",
              "operating_cash_flow",
              "accounts_receivable",
              "inventory",
              "cash_conversion",
              "one_off_contribution",
              "capex",
              "debt_and_cash",
              "profit_cash_divergence",
              "counter_evidence"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "performed",
              "unavailable",
              "not_applicable"
            ]
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "$ref": "../v1.4/common.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "../v1.4/common.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        }
      },
      "minItems": 1,
      "maxItems": 30
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "../v1.4/claim.schema.json"
      }
    },
    "risk_claim_ids": {
      "type": "array",
      "items": {
        "$ref": "../v1.4/common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "monitoring_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "monitor_code",
          "title",
          "rationale",
          "trigger",
          "next_review",
          "fact_ids",
          "evidence_ids"
        ],
        "properties": {
          "monitor_code": {
            "$ref": "../v1.4/common.schema.json#/$defs/identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "next_review": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "fact_ids": {
            "type": "array",
            "items": {
              "$ref": "../v1.4/common.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "../v1.4/common.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1,
      "maxItems": 2
    },
    "source_document_ids": {
      "type": "array",
      "items": {
        "$ref": "../v1.4/common.schema.json#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 30
    },
    "skill_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-candidate\\.[0-9]+)?$"
    },
    "skill_hash": {
      "$ref": "../v1.4/common.schema.json#/$defs/sha256"
    },
    "formula_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "label",
        "search_terms",
        "preferred_sections"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "enum": [
            "company_overview",
            "earnings_change",
            "growth_analysis",
            "financial_health",
            "risk_analysis",
            "business_analysis"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "search_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 40
        },
        "preferred_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 12
        }
      }
    },
    "analysis_sections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text",
          "evidence_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "../v1.4/common.schema.json#/$defs/identifier"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        }
      }
    },
    "overall_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "rationale"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "Strongly Supported",
            "Supported",
            "Mixed",
            "Weak Evidence",
            "Insufficient Evidence"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "suggested_follow_ups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 4,
      "maxItems": 6,
      "uniqueItems": true
    },
    "evidence_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_chunk_count",
        "selected_chunk_count",
        "selected_evidence_ids",
        "cited_evidence_ids",
        "sections"
      ],
      "properties": {
        "available_chunk_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected_chunk_count": {
          "type": "integer",
          "minimum": 2
        },
        "selected_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "../v1.4/common.schema.json#/$defs/identifier"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "cited_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "../v1.4/common.schema.json#/$defs/identifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "peer_comparison"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "properties": {
          "companies": {
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "else": {
        "properties": {
          "companies": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "financial_snapshot_fact_ids": {
            "minItems": 1
          },
          "claims": {
            "minItems": 1
          },
          "source_document_ids": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
