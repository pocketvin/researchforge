{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.8/retrieval-benchmark.schema.json",
  "title": "ResearchForge V1.8 Retrieval Benchmark",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_count", "router_accuracy", "strategies", "cases", "decision_rule"],
  "$defs": {
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recall_at_5", "recall_at_10", "precision_at_5", "mrr"],
      "properties": {
        "recall_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "recall_at_10": {"type": "number", "minimum": 0, "maximum": 1},
        "precision_at_5": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "strategies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexical", "tfidf_vector", "hybrid_rrf"],
      "properties": {
        "lexical": {"$ref": "#/$defs/metrics"},
        "tfidf_vector": {"$ref": "#/$defs/metrics"},
        "hybrid_rrf": {"$ref": "#/$defs/metrics"}
      }
    },
    "ranking": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "properties": {
    "schema_version": {"const": "1.8.0"},
    "case_count": {"type": "integer", "minimum": 1},
    "router_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "strategies": {"$ref": "#/$defs/strategies"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "question", "expected_skill", "observed_skill", "router_pass", "relevant_evidence_ids", "rankings", "metrics"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "expected_skill": {"type": "string", "minLength": 1},
          "observed_skill": {"type": "string", "minLength": 1},
          "router_pass": {"type": "boolean"},
          "relevant_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "rankings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lexical", "tfidf_vector", "hybrid_rrf"],
            "properties": {
              "lexical": {"$ref": "#/$defs/ranking"},
              "tfidf_vector": {"$ref": "#/$defs/ranking"},
              "hybrid_rrf": {"$ref": "#/$defs/ranking"}
            }
          },
          "metrics": {"$ref": "#/$defs/strategies"}
        }
      }
    },
    "decision_rule": {"type": "string", "minLength": 20}
  }
}
