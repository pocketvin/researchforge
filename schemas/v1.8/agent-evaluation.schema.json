{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.8/agent-evaluation.schema.json",
  "title": "ResearchForge V1.8 Product Agent Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "component_eval", "retrieval_benchmark", "passed", "run_evaluations"],
  "$defs": {
    "metricMap": {"type": "object", "additionalProperties": {"type": "number"}},
    "runEval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "task_success", "terminal_state", "metrics", "failure"],
      "properties": {
        "schema_version": {"const": "1.8.0"},
        "run_id": {"type": ["string", "null"]},
        "task_success": {"type": "boolean"},
        "terminal_state": {"type": "string"},
        "synthesis_mode": {"type": ["string", "null"]},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["company_ids", "research_question"],
          "properties": {
            "company_ids": {"type": "array", "items": {"type": "string"}},
            "research_question": {"type": "string"}
          }
        },
        "metrics": {"$ref": "#/$defs/metricMap"},
        "failure": {"oneOf": [{"type": "null"}, {"$ref": "failure-analysis.schema.json"}]}
      }
    },
    "threadEval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "turn_count", "run_ids", "eligible_thread", "same_company_context", "all_turns_successful", "no_duplicate_run_ids", "grounding_preserved", "semantic_consistency_scored", "semantic_consistency_note"],
      "properties": {
        "schema_version": {"const": "1.8.0"},
        "turn_count": {"type": "integer", "minimum": 2},
        "run_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "eligible_thread": {"type": "boolean"},
        "same_company_context": {"type": "boolean"},
        "all_turns_successful": {"type": "boolean"},
        "no_duplicate_run_ids": {"type": "boolean"},
        "grounding_preserved": {"type": "boolean"},
        "semantic_consistency_scored": {"const": false},
        "semantic_consistency_note": {"type": "string", "minLength": 20}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.8.0"},
    "suite_id": {"type": ["string", "null"]},
    "component_eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["router_accuracy", "retrieval"],
      "properties": {
        "router_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "retrieval": {"$ref": "retrieval-benchmark.schema.json#/$defs/strategies"}
      }
    },
    "retrieval_benchmark": {"$ref": "retrieval-benchmark.schema.json"},
    "passed": {"type": "boolean"},
    "run_evaluations": {"type": "array", "items": {"$ref": "#/$defs/runEval"}},
    "thread_eval": {"$ref": "#/$defs/threadEval"}
  }
}
