{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.4/calculation-record.schema.json",
  "title": "ResearchForge Calculation Record",
  "description": "Deterministic financial calculation input, outcome, and formula provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calculation_id",
    "run_id",
    "formula_code",
    "formula_version",
    "input_fact_ids",
    "status",
    "value",
    "measurement_unit",
    "explanation",
    "created_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "calculation_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "formula_code": {
      "type": "string",
      "enum": ["absolute_change", "growth_rate", "gross_profit", "gross_margin", "margin_change_pp", "cash_conversion", "working_capital_change", "profit_cash_divergence", "ytd_to_discrete"]
    },
    "formula_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "input_fact_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/identifier" },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": { "type": "string", "enum": ["calculated", "not_meaningful", "unreliable", "unavailable"] },
    "value": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "maxLength": 128
    },
    "measurement_unit": { "type": ["string", "null"], "maxLength": 64 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "calculated" } }, "required": ["status"] },
      "then": { "properties": { "value": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?$" } } },
      "else": { "properties": { "value": { "type": "null" } } }
    }
  ]
}
