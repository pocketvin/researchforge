{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.4/skill-version.schema.json",
  "title": "ResearchForge Skill Version",
  "description": "Immutable fundamental-research skill version and activation history.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_version_id",
    "skill_name",
    "version",
    "content_hash",
    "parent_version_id",
    "source_patch_id",
    "status",
    "content_path",
    "created_at",
    "activated_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "skill_version_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "skill_name": { "type": "string", "const": "fundamental-research" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-candidate\\.[0-9]+)?$" },
    "content_hash": { "$ref": "common.schema.json#/$defs/sha256" },
    "parent_version_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "source_patch_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "status": { "type": "string", "enum": ["seed", "candidate", "active", "rejected", "rolled_back", "historical"] },
    "content_path": { "type": "string", "minLength": 1, "maxLength": 500 },
    "created_at": { "type": "string", "format": "date-time" },
    "activated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
