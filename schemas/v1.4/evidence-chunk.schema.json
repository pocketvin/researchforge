{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.4/evidence-chunk.schema.json",
  "title": "ResearchForge Evidence Chunk",
  "description": "A stable, point-in-time chunk of untrusted filing or announcement content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "document_id",
    "company",
    "document_type",
    "published_at",
    "retrieved_at",
    "content_role",
    "section",
    "text",
    "text_hash",
    "source_uri",
    "locator"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "chunk_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "document_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "company": {
      "$ref": "common.schema.json#/$defs/company"
    },
    "reporting_period": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/reportingPeriod"
        },
        {
          "type": "null"
        }
      ]
    },
    "document_type": {
      "type": "string",
      "enum": [
        "annual_report",
        "interim_report",
        "quarterly_report",
        "earnings_announcement",
        "official_announcement"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_role": {
      "type": "string",
      "const": "untrusted_source"
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "text_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_uri": {
      "type": "string",
      "format": "uri"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_start",
        "page_end"
      ],
      "properties": {
        "page_start": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "paragraph_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "char_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "char_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "parser_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "text_native",
          "ocr",
          "table_linearized",
          "low_confidence_parse",
          "manual_reviewed"
        ]
      },
      "uniqueItems": true
    }
  }
}
