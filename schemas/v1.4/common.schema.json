{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.4/common.schema.json",
  "title": "ResearchForge V1.4 Common Definitions",
  "description": "Shared definitions for all ResearchForge V1.4 persisted artifacts.",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.4.0"
    },
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_id",
        "legal_name",
        "ticker",
        "exchange",
        "country_code"
      ],
      "properties": {
        "company_id": {
          "$ref": "#/$defs/identifier"
        },
        "legal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ticker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "exchange": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "reportingPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_start",
        "period_end",
        "fiscal_year",
        "fiscal_period",
        "period_basis",
        "accounting_standard",
        "statement_scope",
        "restatement_status"
      ],
      "properties": {
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "fiscal_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "fiscal_period": {
          "type": "string",
          "enum": [
            "Q1",
            "Q2",
            "Q3",
            "Q4",
            "H1",
            "FY",
            "TTM"
          ]
        },
        "period_basis": {
          "type": "string",
          "enum": [
            "instant",
            "discrete",
            "ytd",
            "ttm"
          ]
        },
        "accounting_standard": {
          "type": "string",
          "enum": [
            "CAS",
            "IFRS",
            "US_GAAP",
            "OTHER"
          ]
        },
        "statement_scope": {
          "type": "string",
          "enum": [
            "consolidated",
            "parent_company",
            "company_only"
          ]
        },
        "restatement_status": {
          "type": "string",
          "enum": [
            "as_reported",
            "restated",
            "derived_from_restated"
          ]
        }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "document_id",
        "source_type",
        "published_at",
        "retrieved_at",
        "uri",
        "content_hash"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_filing",
            "official_announcement",
            "licensed_structured_data",
            "benchmark_fixture"
          ]
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "license_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "redistribution_allowed": {
          "type": "boolean"
        }
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_snapshot",
        "temperature",
        "reasoning_effort",
        "max_output_tokens",
        "tool_choice_policy",
        "store",
        "built_in_tools"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_snapshot": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "tool_choice_policy": {
          "type": "string",
          "enum": [
            "auto",
            "required",
            "controlled"
          ]
        },
        "store": {
          "type": "boolean",
          "const": false
        },
        "built_in_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 0
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "latency_ms",
        "tool_calls"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
