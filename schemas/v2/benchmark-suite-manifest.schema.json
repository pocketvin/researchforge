{
  "$defs": {
    "BenchmarkSuiteCase": {
      "additionalProperties": false,
      "properties": {
        "financebench_id": {
          "minLength": 1,
          "title": "Financebench Id",
          "type": "string"
        },
        "stratum": {
          "minLength": 1,
          "title": "Stratum",
          "type": "string"
        },
        "company": {
          "minLength": 1,
          "title": "Company",
          "type": "string"
        },
        "doc_name": {
          "minLength": 1,
          "title": "Doc Name",
          "type": "string"
        },
        "question_type": {
          "minLength": 1,
          "title": "Question Type",
          "type": "string"
        },
        "question_reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Reasoning"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "financebench_id",
        "stratum",
        "company",
        "doc_name",
        "question_type",
        "question"
      ],
      "title": "BenchmarkSuiteCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_id": {
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "benchmark_name": {
      "const": "FinanceBench open-source",
      "default": "FinanceBench open-source",
      "title": "Benchmark Name",
      "type": "string"
    },
    "benchmark_commit": {
      "maxLength": 40,
      "minLength": 40,
      "title": "Benchmark Commit",
      "type": "string"
    },
    "benchmark_license": {
      "minLength": 1,
      "title": "Benchmark License",
      "type": "string"
    },
    "split": {
      "const": "development",
      "default": "development",
      "title": "Split",
      "type": "string"
    },
    "selector_version": {
      "minLength": 1,
      "title": "Selector Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "source_questions_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Source Questions Sha256",
      "type": "string"
    },
    "source_question_count": {
      "exclusiveMinimum": 0,
      "title": "Source Question Count",
      "type": "integer"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "gold_fields_used_in_selection": {
      "const": false,
      "default": false,
      "title": "Gold Fields Used In Selection",
      "type": "boolean"
    },
    "anchors": {
      "items": {
        "type": "string"
      },
      "title": "Anchors",
      "type": "array"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/BenchmarkSuiteCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "suite_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Suite Hash",
      "type": "string"
    }
  },
  "required": [
    "suite_id",
    "benchmark_commit",
    "benchmark_license",
    "selector_version",
    "seed",
    "source_questions_sha256",
    "source_question_count",
    "scope",
    "anchors",
    "cases",
    "suite_hash"
  ],
  "title": "BenchmarkSuiteManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v2/benchmark-suite-manifest.schema.json"
}
