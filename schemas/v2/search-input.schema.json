{
  "additionalProperties": false,
  "properties": {
    "query": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "kind": {
      "default": "all",
      "enum": [
        "all",
        "page",
        "section",
        "table",
        "figure",
        "footnote",
        "evidence"
      ],
      "title": "Kind",
      "type": "string"
    },
    "document_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,254}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Id"
    },
    "offset": {
      "default": 0,
      "maximum": 10000,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "limit": {
      "default": 6,
      "maximum": 12,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    }
  },
  "required": [
    "query"
  ],
  "title": "SearchInput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v2/search-input.schema.json"
}
