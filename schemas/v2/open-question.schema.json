{
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,254}$",
      "title": "Question Id",
      "type": "string"
    },
    "question": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "answered",
        "not_answerable_from_filings"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,254}$",
        "type": "string"
      },
      "maxItems": 30,
      "title": "Evidence Ids",
      "type": "array"
    },
    "explanation": {
      "default": "",
      "maxLength": 2000,
      "title": "Explanation",
      "type": "string"
    }
  },
  "required": [
    "question_id",
    "question",
    "priority",
    "status"
  ],
  "title": "OpenQuestion",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v2/open-question.schema.json"
}
