{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "suite_id": {
      "minLength": 1,
      "title": "Suite Id",
      "type": "string"
    },
    "bundle_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Hash",
      "type": "string"
    },
    "implementation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Hash",
      "type": "string"
    },
    "git_head": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Head"
    },
    "git_dirty": {
      "title": "Git Dirty",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state": {
      "default": "armed",
      "enum": [
        "armed",
        "running",
        "completed",
        "technical_failure",
        "retired"
      ],
      "title": "State",
      "type": "string"
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Of"
    },
    "retry_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry Reason"
    },
    "results_opened_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Results Opened At"
    },
    "human_review_completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Review Completed At"
    },
    "tuning_performed_after_results": {
      "default": false,
      "title": "Tuning Performed After Results",
      "type": "boolean"
    }
  },
  "required": [
    "attempt_id",
    "suite_id",
    "bundle_hash",
    "implementation_hash",
    "git_dirty",
    "started_at"
  ],
  "title": "HeldOutAcceptanceAttempt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v2/heldout-acceptance-attempt.schema.json"
}
