        "type": "string"
      },
      "maxItems": 24,
      "title": "Findings",
      "type": "array"
    },
    "sections": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Sections",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "title",
    "executive_summary",
    "findings",
    "sections",
    "limitations"
