{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "suite_id": {
      "title": "Suite Id",
      "type": "string"
    },
    "bundle_hash": {
      "title": "Bundle Hash",
      "type": "string"
    },
    "review_mode": {
      "enum": [
        "pairwise_preference",
        "meets_standard"
      ],
      "title": "Review Mode",
      "type": "string"
    },
    "total_cases": {
      "title": "Total Cases",
      "type": "integer"
    },
    "verdict_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Verdict Counts",
      "type": "object"
    },
    "candidate_preference_counts": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Preference Counts"
    },
    "decisive_pairwise_cases": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decisive Pairwise Cases"
    },
    "meets_standard_cases": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Meets Standard Cases"
    },
    "cannot_judge_cases": {
      "title": "Cannot Judge Cases",
      "type": "integer"
    },
    "note": {
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "suite_id",
    "bundle_hash",
    "review_mode",
    "total_cases",
    "verdict_counts",
    "cannot_judge_cases",
    "note"
  ],
  "title": "HumanAcceptanceSummary",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v2/heldout-human-acceptance-summary.schema.json"
}
