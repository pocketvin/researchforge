{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.3/project-checkpoint.schema.json",
  "title": "ResearchForge Project Checkpoint",
  "description": "A machine-readable handoff for current gate, evidence, blockers, and the single next action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "product_scope_version",
    "contract_package_version",
    "completed_gates",
    "current_gate",
    "gate_status",
    "current_milestone",
    "last_verified",
    "next_action",
    "blockers",
    "pending_decisions",
    "resumption",
    "last_session",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "project_id": {
      "type": "string",
      "const": "researchforge"
    },
    "product_scope_version": {
      "type": "string",
      "const": "1.3"
    },
    "contract_package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "completed_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      },
      "uniqueItems": true
    },
    "current_gate": {
      "$ref": "#/$defs/gate"
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "completed"
      ]
    },
    "current_milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "outcome",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "outcome": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "in_progress",
            "blocked",
            "completed"
          ]
        }
      }
    },
    "last_verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "commands"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifiedCommand"
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "why",
        "first_step",
        "acceptance_evidence"
      ],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "why": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "first_step": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "acceptance_evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "maxItems": 12
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      },
      "maxItems": 20
    },
    "pending_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pendingDecision"
      },
      "maxItems": 20
    },
    "resumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "working_directory",
        "read_first",
        "commands"
      ],
      "properties": {
        "working_directory": {
          "type": "string",
          "const": "."
        },
        "read_first": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 5
        }
      }
    },
    "last_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ended_at",
        "summary",
        "files_changed"
      ],
      "properties": {
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "files_changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "maxItems": 100,
          "uniqueItems": true
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "gate": {
      "type": "string",
      "enum": [
        "C0",
        "G0",
        "G1_THIN",
        "G2",
        "G3",
        "G1_FULL",
        "G4"
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "verifiedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "summary"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "summary": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "blocks",
        "owner_action"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gate"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "owner_action": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "pendingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "question",
        "blocks_gate"
      ],
      "properties": {
        "decision_id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "question": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "blocks_gate": {
          "$ref": "#/$defs/gate"
        }
      }
    }
  }
}

