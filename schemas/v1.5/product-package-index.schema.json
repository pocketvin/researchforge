{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.5/product-package-index.schema.json",
  "title": "Bounded ResearchForge Product Package Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "package_hash", "data_namespace", "status", "packages"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "package_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "package_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "data_namespace": {"const": "product"},
    "status": {"const": "ready"},
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "package_id", "package_hash"],
        "properties": {
          "path": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "package_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "package_hash": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    }
  }
}
