{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchforge.local/schemas/v1.5/financial-fact-extraction.schema.json",
  "title": "ResearchForge V1.5 Deterministic Financial Fact Extraction",
  "description": "An all-or-nothing recovery record proving that each promoted number is deterministically recoverable from a verified PDF text layer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extractor_name",
    "extractor_version",
    "method",
    "numerical_truth_source",
    "llm_used",
    "ambiguity_policy",
    "target_metrics",
    "promoted_metric_count",
    "parser_text_hash",
    "recoveries"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "extractor_name": {"type": "string", "const": "researchforge_deterministic_financial_statement"},
    "extractor_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "method": {"type": "string", "const": "deterministic_pdf_text_recovery"},
    "numerical_truth_source": {"type": "string", "const": "verified_pdf"},
    "llm_used": {"type": "boolean", "const": false},
    "ambiguity_policy": {"type": "string", "const": "abstain_entire_package"},
    "target_metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metricCode"},
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "promoted_metric_count": {"type": "integer", "const": 6},
    "parser_text_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "recoveries": {
      "type": "array",
      "items": {"$ref": "#/$defs/recovery"},
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    }
  },
  "$defs": {
    "metricCode": {
      "type": "string",
      "enum": [
        "revenue",
        "operating_cost",
        "net_income",
        "operating_cash_flow",
        "accounts_receivable",
        "inventory"
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_code",
        "statement",
        "page",
        "line_start",
        "line_end",
        "row_label",
        "column_label",
        "raw_value",
        "reported_value",
        "unit_label",
        "scale",
        "normalized_value",
        "evidence_text",
        "evidence_text_hash",
        "page_text_hash",
        "recovery_hash"
      ],
      "properties": {
        "metric_code": {"$ref": "#/$defs/metricCode"},
        "statement": {
          "type": "string",
          "enum": ["合并资产负债表", "合并利润表", "合并现金流量表"]
        },
        "page": {"type": "integer", "minimum": 1, "maximum": 5000},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "row_label": {"type": "string", "minLength": 1, "maxLength": 256},
        "column_label": {"type": "string", "minLength": 1, "maxLength": 128},
        "raw_value": {"type": "string", "minLength": 1, "maxLength": 128},
        "reported_value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "unit_label": {"type": "string", "enum": ["元", "千元", "万元", "百万元"]},
        "scale": {"type": "integer", "enum": [1, 1000, 10000, 1000000]},
        "normalized_value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "evidence_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_text_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "page_text_hash": {"$ref": "common.schema.json#/$defs/sha256"},
        "recovery_hash": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
